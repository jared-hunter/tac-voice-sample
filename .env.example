TWILIO_MEMORY_LOAD_TRAITS=
TWILIO_TRAIT_GROUPS=Contact,Preferences


# OPTIONAL: Knowledge Base
TWILIO_KNOWLEDGE_BASE_ID=
TWILIO_KNOWLEDGE_BASE_PROMPT=

# Anthropic / Claude
ANTHROPIC_API_KEY=

# Agent persona (optional override)
AI_AGENT_NAME=AI Support